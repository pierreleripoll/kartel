{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static site made by `pnpm generate` in .output/public, served by
  // Cloudflare Workers static assets. No worker code.
  "name": "kartel",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": ".output/public",
    // The real 404.html made by Nuxt (this is not a SPA).
    "not_found_handling": "404-page",
    // /fr/tandem serves fr/tandem/index.html with no redirect.
    "html_handling": "drop-trailing-slash"
  }
}
